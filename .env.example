# ─── Куда отправлять ────────────────────────────────────────────────────────────
# Приватный КАНАЛ (рекомендуется) или супергруппа.
# Формат: -1001234567890  (числовой id) либо @username для публичных.
TELEGRAM_CHAT_ID=-1001234567890

# Для форум-супергруппы (топики) можно указать id топика, иначе оставить пустым
TELEGRAM_TOPIC_ID=

# ─── Бот (файлы до 50 МБ) ───────────────────────────────────────────────────────
# Получить у @BotFather. Бота нужно добавить в канал/группу и дать право постить.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Если поднят свой Bot API server (--local), лимит бота становится 2000 МБ.
# TELEGRAM_BOT_API_ROOT=http://127.0.0.1:8081

# ─── Аккаунт / MTProto (файлы больше 50 МБ) ────────────────────────────────────
# api_id и api_hash получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Заполняется автоматически после `npm run login` (можно и вручную)
TELEGRAM_SESSION=

# ─── Поведение ──────────────────────────────────────────────────────────────────
# Каталоги для сканирования (через запятую). Пример: /Volumes/USB,/media/user/IPHONE
SCAN_PATHS=

# База отправленных файлов
DB_PATH=./data/cloudtelega.db

# Временные файлы (конвертация HEIC)
TMP_DIR=./tmp

# Что делать с HEIC/HEIF:
#   document — отправить оригинал как файл (без потерь, рекомендуется)
#   convert  — сконвертировать в JPEG и отправить только его
#   both     — отправить и оригинал, и JPEG-превью
HEIC_MODE=document

# Качество JPEG при конвертации HEIC (1..100)
HEIC_JPEG_QUALITY=92

# Отправлять всё как документ (без сжатия Telegram). true — архивное качество.
SEND_AS_DOCUMENT=true

# Пауза между отправками, мс (защита от flood-limit)
SEND_DELAY_MS=1200

# Сколько раз пробовать переотправить файл
MAX_ATTEMPTS=3
