# ─── Куда отправлять ────────────────────────────────────────────────────────────
# Приватный КАНАЛ — чистая хронологическая лента.
# Приватная СУПЕРГРУППА с включёнными темами — если нужны топики по годам.
# Формат: -1001234567890 (числовой id) либо @username для публичных.
TELEGRAM_CHAT_ID=-1001234567890

# none — всё одной лентой
# year — раскладывать по топикам-годам (2019, 2020, …), нужна супергруппа-форум,
#        бот должен быть админом с правом «Управление темами»
TOPIC_MODE=none

# Фиксированный топик (если TOPIC_MODE=none, а писать нужно в конкретную тему)
TELEGRAM_TOPIC_ID=

# ─── Бот (файлы до 50 МБ) ───────────────────────────────────────────────────────
# Получить у @BotFather. Бота нужно добавить в канал/группу и дать право постить.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Если поднят свой Bot API server (--local), лимит бота становится 2000 МБ.
# TELEGRAM_BOT_API_ROOT=http://127.0.0.1:8081

# ─── Аккаунт / MTProto (файлы больше 50 МБ) ────────────────────────────────────
# api_id и api_hash получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Заполняется автоматически после `npm run login`
TELEGRAM_SESSION=

# ─── Что сканировать ────────────────────────────────────────────────────────────
# Каталоги через запятую. Пример: /Volumes/USB,/home/user/iphone/DCIM
SCAN_PATHS=

DB_PATH=./data/cloudtelega.db
TMP_DIR=./tmp

# ─── Как отправлять ─────────────────────────────────────────────────────────────
# false — лентой: фото с превью, видео проигрывается прямо в чате (Telegram сожмёт)
# true  — документами: оригинал без сжатия и с EXIF, но превью в ленте не будет
SEND_AS_DOCUMENT=false

# HEIC/HEIF:
#   auto     — по режиму выше: лента → convert, документы → document (по умолчанию)
#   convert  — сконвертировать в JPEG и отправить его
#   document — отправить оригинал .heic файлом
#   both     — отправить и JPEG (для ленты), и оригинал (для архива)
HEIC_MODE=auto

# Оставлять оригинал HEIC рядом с JPEG в режиме ленты (то же, что HEIC_MODE=both)
KEEP_HEIC_ORIGINAL=false

# Качество JPEG при конвертации HEIC (1..100)
HEIC_JPEG_QUALITY=92

# ─── Дубликаты ──────────────────────────────────────────────────────────────────
# Что выбрать, если рядом лежат IMG_0001.HEIC и IMG_0001.JPG:
#   auto     — jpeg в режиме ленты, original в режиме документов
#   original — всегда исходный формат (HEIC/RAW важнее)
#   jpeg     — всегда готовый JPEG (не требует конвертации)
PAIR_PREFER=auto

# .MOV рядом с фото того же имени — это Live Photo:
#   live — отправить парой, одним сообщением-Live Photo (по умолчанию;
#          требуется бот с Bot API 10.0, в архивном режиме документов не применяется)
#   send — отправить видео отдельным сообщением
#   skip — не отправлять видео вовсе
LIVE_PHOTO_VIDEOS=live

# Искать готовый sha256 по имени+размеру+времени файла — чтобы повторное
# подключение того же диска (другая точка монтирования) не перечитывало его целиком
FAST_REMOUNT_MATCH=true

# Проверять по базе «то же имя без расширения + та же дата съёмки» из прошлых запусков
CROSS_RUN_NAME_CHECK=true

# ─── Управление ботом из Telegram (npm run bot) ────────────────────────────────
# Кто может отдавать команды боту — свой id узнать командой /id в личке с ботом.
# Без этого списка бот отвечает только на /id.
TELEGRAM_ADMIN_IDS=

# Разрешить командам /scan и /send любые каталоги, а не только SCAN_PATHS
# и смонтированные диски
BOT_ALLOW_ANY_PATH=false

# ─── Темп отправки ──────────────────────────────────────────────────────────────
SEND_DELAY_MS=1200
MAX_ATTEMPTS=3
